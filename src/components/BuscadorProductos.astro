---
import Container from './base/Container.astro';
import { getProductLines } from '../data/productosData';

// Obtener líneas disponibles del API para mostrar en el select de filtro
let availableLines: string[] = [];
try {
  const lines = await getProductLines();
  availableLines = Object.keys(lines);
} catch (error) {
  console.warn('Error loading product lines:', error);
  availableLines = [];
}
---

<Container>
  <div class="mb-12">
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between mb-8">
      <div class="w-full md:w-2/3">
        <input
          id="searchInput"
          type="text"
          placeholder="Busca un producto (ej: ESCOBA, BASTON, CLORO)..."
          class="w-full px-6 py-3 border-2 border-lluvia-primary rounded-lg focus:outline-none focus:border-lluvia-secondary text-lg"
        />
      </div>
      
      <select
        id="filterLine"
        class="w-full md:w-1/3 px-6 py-3 border-2 border-lluvia-primary rounded-lg focus:outline-none focus:border-lluvia-secondary text-lg"
      >
        <option value="">Todas las líneas</option>
        {availableLines.map((line: string) => (
          <option value={line}>{line}</option>
        ))}
      </select>
    </div>

    <div class="flex items-center justify-between mb-6">
      <div class="text-sm text-gray-600">
        <span id="resultCount">Cargando...</span>
      </div>
      
      <div class="flex items-center gap-3">
        <label for="pageSize" class="text-sm text-gray-600">Por página:</label>
        <select
          id="pageSize"
          class="px-4 py-2 border border-lluvia-primary rounded-lg focus:outline-none focus:border-lluvia-secondary text-sm"
        >
          <option value="10">10</option>
          <option value="25" selected>25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Grid de Productos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12" id="productsGrid">
    <!-- Los productos se cargarán dinámicamente desde el API -->
  </div>

  <!-- Mensaje sin resultados -->
  <div
    id="noResults"
    class="hidden text-center py-12"
  >
    <div class="text-6xl mb-4">🔍</div>
    <h3 class="text-2xl font-bold text-gray-700 mb-2">No encontramos productos</h3>
    <p class="text-gray-600">Intenta con otra búsqueda o filtro diferente</p>
  </div>

  <!-- Controles de Paginación -->
  <div class="flex items-center justify-center gap-2 mb-8" id="paginationControls">
    <button
      id="prevBtn"
      disabled
      class="px-4 py-2 border border-lluvia-primary rounded-lg text-lluvia-primary hover:bg-lluvia-primary hover:text-white disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
    >
      ← Anterior
    </button>
    
    <div id="pageNumbersContainer" class="flex gap-2">
      <!-- Los números de página se generarán dinámicamente -->
    </div>
    
    <button
      id="nextBtn"
      class="px-4 py-2 border border-lluvia-primary rounded-lg text-lluvia-primary hover:bg-lluvia-primary hover:text-white disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
    >
      Siguiente →
    </button>
  </div>

  <div id="loadingIndicator" class="text-center py-8">
    <div class="inline-block">
      <div class="animate-spin">⏳</div>
      <p class="text-gray-600 mt-2">Cargando productos...</p>
    </div>
  </div>
</Container>

<script>
  interface PaginationState {
    currentPage: number;
    pageSize: number;
    totalPages: number;
    totalRecords: number;
    searchTerm: string;
    selectedLine: string;
  }

  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const filterLine = document.getElementById('filterLine') as HTMLSelectElement;
  const pageSizeSelect = document.getElementById('pageSize') as HTMLSelectElement;
  const productsGrid = document.getElementById('productsGrid') as HTMLElement;
  const noResults = document.getElementById('noResults') as HTMLElement;
  const resultCount = document.getElementById('resultCount') as HTMLElement;
  const paginationControls = document.getElementById('paginationControls') as HTMLElement;
  const pageNumbersContainer = document.getElementById('pageNumbersContainer') as HTMLElement;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const loadingIndicator = document.getElementById('loadingIndicator') as HTMLElement;
  
  let paginationState: PaginationState = {
    currentPage: 1,
    pageSize: 25,
    totalPages: 1,
    totalRecords: 0,
    searchTerm: '',
    selectedLine: ''
  };

  let allProductsCache: any[] = [];

  // Mapeo de líneas a IDs que se cargará desde el API
  let lineToIdMap: Record<string, number> = {};

  // Debounce para búsqueda
  let searchTimeout: NodeJS.Timeout | null = null;
  const SEARCH_DELAY = 400; // milisegundos

  // Importar y cargar el mapeo de líneas desde el API
  async function initializeLineIdMap() {
    try {
      const { getLineIdMap } = await import('../data/productosData');
      lineToIdMap = await getLineIdMap();
    } catch (error) {
      console.warn('Error loading line ID map:', error);
      lineToIdMap = {};
    }
  }

  async function loadProductsFromAPI(page: number, pageSize: number, lineId?: number, description?: string) {
    try {
      loadingIndicator.classList.remove('hidden');
      
      const { getProductosPaginados } = await import('../data/productosData');
      
      const result = await getProductosPaginados({
        pageNumber: page,
        pageSize: pageSize,
        idLineaProducto: lineId,
        descripcion: description
      });
      
      allProductsCache = result.data || [];
      paginationState.totalPages = result.totalPages || 1;
      paginationState.totalRecords = result.totalRecords || 0;
      
      loadingIndicator.classList.add('hidden');
      renderProducts();
      updatePaginationUI();
    } catch (error) {
      console.error('Error loading products:', error);
      loadingIndicator.classList.add('hidden');
      noResults.classList.remove('hidden');
      productsGrid.style.display = 'none';
    }
  }

  function renderProducts() {
    productsGrid.innerHTML = '';
    
    if (allProductsCache.length === 0) {
      productsGrid.style.display = 'none';
      noResults.classList.remove('hidden');
      resultCount.textContent = 'No se encontraron productos';
      return;
    }

    productsGrid.style.display = 'grid';
    noResults.classList.add('hidden');

    allProductsCache.forEach((product: any) => {
      const productName = product.descripcion || product.nombre || '';
      const productArticulo = product.articulo || '';
      const productLine = product.line || 'Sin categoría';
      const productPrice = product.precioIndividual || 0;
      
      // Formatear precio como moneda
      const formattedPrice = new Intl.NumberFormat('es-CO', {
        style: 'currency',
        currency: 'COP',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0
      }).format(productPrice);
      
      const div = document.createElement('div');
      div.className = 'product-item';
      div.setAttribute('data-product-name', productName.toLowerCase());
      div.setAttribute('data-product-articulo', productArticulo.toLowerCase());
      div.setAttribute('data-product-line', productLine);

      const icon = product.icon || '🏷️';
      const color = product.color || 'bg-slate-500';

      div.innerHTML = `
        <div class="bg-white rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 p-6 h-full flex flex-col">
          <div class="flex items-start gap-4 mb-4">
            <div class="${color} text-white text-3xl w-14 h-14 rounded-lg flex items-center justify-center flex-shrink-0">
              ${icon}
            </div>
            <div class="flex-grow">
              <p class="text-xs text-lluvia-primary font-semibold uppercase">
                ${productLine}
              </p>
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-lluvia-secondary mb-2 break-words flex-grow">
            ${productName}
          </h3>
          
          <p class="text-sm text-gray-600 mb-3">
            ${productArticulo || 'Código no disponible'}
          </p>

          <div class="bg-gray-100 text-lluvia-primary font-bold text-lg px-3 py-2 rounded-lg text-center border-2 border-lluvia-primary">
            ${formattedPrice}
          </div>
        </div>
      `;
      
      productsGrid.appendChild(div);
    });

    resultCount.textContent = `Mostrando ${allProductsCache.length} de ${paginationState.totalRecords} productos`;
  }

  function updatePaginationUI() {
    pageNumbersContainer.innerHTML = '';
    
    const maxButtons = 5;
    let startPage = Math.max(1, paginationState.currentPage - Math.floor(maxButtons / 2));
    let endPage = Math.min(paginationState.totalPages, startPage + maxButtons - 1);
    
    if (endPage - startPage < maxButtons - 1) {
      startPage = Math.max(1, endPage - maxButtons + 1);
    }

    // Botón primera página
    if (startPage > 1) {
      const firstBtn = document.createElement('button');
      firstBtn.textContent = '1';
      firstBtn.className = 'px-3 py-2 border border-gray-300 rounded-lg hover:bg-gray-100';
      firstBtn.onclick = () => goToPage(1);
      pageNumbersContainer.appendChild(firstBtn);

      if (startPage > 2) {
        const dots = document.createElement('span');
        dots.textContent = '...';
        dots.className = 'px-2 py-2';
        pageNumbersContainer.appendChild(dots);
      }
    }

    // Números de página
    for (let i = startPage; i <= endPage; i++) {
      const btn = document.createElement('button');
      btn.textContent = i.toString();
      btn.className = `px-3 py-2 rounded-lg transition-colors ${
        i === paginationState.currentPage
          ? 'bg-lluvia-primary text-white'
          : 'border border-gray-300 hover:bg-gray-100'
      }`;
      btn.onclick = () => goToPage(i);
      pageNumbersContainer.appendChild(btn);
    }

    // Botón última página
    if (endPage < paginationState.totalPages) {
      if (endPage < paginationState.totalPages - 1) {
        const dots = document.createElement('span');
        dots.textContent = '...';
        dots.className = 'px-2 py-2';
        pageNumbersContainer.appendChild(dots);
      }

      const lastBtn = document.createElement('button');
      lastBtn.textContent = paginationState.totalPages.toString();
      lastBtn.className = 'px-3 py-2 border border-gray-300 rounded-lg hover:bg-gray-100';
      lastBtn.onclick = () => goToPage(paginationState.totalPages);
      pageNumbersContainer.appendChild(lastBtn);
    }

    // Actualizar botones prev/next
    prevBtn.disabled = paginationState.currentPage === 1;
    nextBtn.disabled = paginationState.currentPage === paginationState.totalPages;
  }

  function goToPage(page: number) {
    paginationState.currentPage = page;
    const lineId = paginationState.selectedLine ? lineToIdMap[paginationState.selectedLine] : undefined;
    loadProductsFromAPI(page, paginationState.pageSize, lineId, paginationState.searchTerm);
    
    // Hacer scroll hacia arriba suavemente
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }

  function handleSearch() {
    // Limpiar timeout anterior si existe
    if (searchTimeout) {
      clearTimeout(searchTimeout);
    }

    // Establecer nuevo timeout con debounce
    searchTimeout = setTimeout(() => {
      paginationState.searchTerm = searchInput.value.toLowerCase().trim();
      paginationState.currentPage = 1;
      const lineId = paginationState.selectedLine ? lineToIdMap[paginationState.selectedLine] : undefined;
      loadProductsFromAPI(1, paginationState.pageSize, lineId, paginationState.searchTerm);
      
      // Scroll hacia arriba
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }, SEARCH_DELAY);
  }

  function handleLineFilter() {
    paginationState.selectedLine = filterLine.value;
    paginationState.currentPage = 1;
    const lineId = paginationState.selectedLine ? lineToIdMap[paginationState.selectedLine] : undefined;
    loadProductsFromAPI(1, paginationState.pageSize, lineId, paginationState.searchTerm);
    
    // Scroll hacia arriba
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function handlePageSizeChange() {
    paginationState.pageSize = parseInt(pageSizeSelect.value);
    paginationState.currentPage = 1;
    const lineId = paginationState.selectedLine ? lineToIdMap[paginationState.selectedLine] : undefined;
    loadProductsFromAPI(1, paginationState.pageSize, lineId, paginationState.searchTerm);
    
    // Scroll hacia arriba
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Event listeners
  searchInput.addEventListener('input', handleSearch);
  filterLine.addEventListener('change', handleLineFilter);
  pageSizeSelect.addEventListener('change', handlePageSizeChange);
  prevBtn.addEventListener('click', () => {
    if (paginationState.currentPage > 1) {
      goToPage(paginationState.currentPage - 1);
    }
  });
  nextBtn.addEventListener('click', () => {
    if (paginationState.currentPage < paginationState.totalPages) {
      goToPage(paginationState.currentPage + 1);
    }
  });

  // Inicializar con primera página
  window.addEventListener('load', async () => {
    await initializeLineIdMap();
    goToPage(1);
  });
</script>
