---
import Container from './base/Container.astro';
import { getAllProducts } from '../data/productosData';

const allProducts = getAllProducts();
const uniqueLines = [...new Set(allProducts.map((p: any) => p.line))] as string[];
---

<Container>
  <div class="mb-12">
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between mb-8">
      <div class="w-full md:w-2/3">
        <input
          id="searchInput"
          type="text"
          placeholder="Busca un producto (ej: ESCOBA, BASTON, CLORO)..."
          class="w-full px-6 py-3 border-2 border-lluvia-primary rounded-lg focus:outline-none focus:border-lluvia-secondary text-lg"
        />
      </div>
      
      <select
        id="filterLine"
        class="w-full md:w-1/3 px-6 py-3 border-2 border-lluvia-primary rounded-lg focus:outline-none focus:border-lluvia-secondary text-lg"
      >
        <option value="">Todas las líneas</option>
        {uniqueLines.map((line: string) => (
          <option value={line}>{line}</option>
        ))}
      </select>
    </div>

    <div class="text-sm text-gray-600 mb-6">
      <span id="resultCount">Mostrando {allProducts.length} productos</span>
    </div>
  </div>

  <!-- Grid de Productos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12" id="productsGrid">
    {allProducts.map((product: any) => (
      <div
        class="product-item"
        data-product-name={product.searchText}
        data-product-line={product.line}
      >
        <div class="bg-white rounded-lg shadow-lg hover:shadow-2xl transition-all duration-300 p-6 h-full">
          <div class="flex items-start gap-4 mb-4">
            <div class={`${product.color} text-white text-3xl w-14 h-14 rounded-lg flex items-center justify-center flex-shrink-0`}>
              {product.icon}
            </div>
            <div class="flex-grow">
              <p class="text-xs text-lluvia-primary font-semibold uppercase">
                {product.line}
              </p>
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-lluvia-secondary mb-2 break-words">
            {product.name}
          </h3>
          
          <p class="text-sm text-gray-600">
            {product.description}
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Mensaje sin resultados -->
  <div
    id="noResults"
    class="hidden text-center py-12"
  >
    <div class="text-6xl mb-4">🔍</div>
    <h3 class="text-2xl font-bold text-gray-700 mb-2">No encontramos productos</h3>
    <p class="text-gray-600">Intenta con otra búsqueda o filtro diferente</p>
  </div>
</Container>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const filterLine = document.getElementById('filterLine') as HTMLSelectElement;
  const productsGrid = document.getElementById('productsGrid') as HTMLElement;
  const noResults = document.getElementById('noResults') as HTMLElement;
  const resultCount = document.getElementById('resultCount') as HTMLElement;
  const productItems = Array.from(document.querySelectorAll('.product-item')) as HTMLElement[];

  function filterProducts() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    const selectedLine = filterLine.value.toLowerCase().trim();

    let visibleCount = 0;

    productItems.forEach(item => {
      const productName = item.getAttribute('data-product-name') || '';
      const productLine = item.getAttribute('data-product-line') || '';

      const matchesSearch = !searchTerm || productName.includes(searchTerm);
      const matchesLine = !selectedLine || productLine.toLowerCase() === selectedLine;

      if (matchesSearch && matchesLine) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // Mostrar/ocultar mensaje sin resultados
    if (visibleCount === 0) {
      productsGrid.style.display = 'none';
      noResults.classList.remove('hidden');
    } else {
      productsGrid.style.display = 'grid';
      noResults.classList.add('hidden');
    }

    // Actualizar contador
    resultCount.textContent = `Mostrando ${visibleCount} producto${visibleCount !== 1 ? 's' : ''}`;
  }

  // Event listeners
  searchInput.addEventListener('input', filterProducts);
  filterLine.addEventListener('change', filterProducts);
</script>
