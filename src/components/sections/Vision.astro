---
import Container from '../base/Container.astro';
import Card from '../base/Card.astro';
---

<section class="relative bg-gradient-to-br from-lluvia-secondary via-lluvia-secondary to-[#1a1a1a] text-white py-20" id="vision">
  <!-- Orbes decorativos con color lluvia-primary -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-0 w-96 h-96 bg-lluvia-primary opacity-10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-lluvia-primary opacity-10 rounded-full blur-3xl"></div>
  </div>

  <Container className="relative z-10">
    <div data-aos="fade-up" class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Nuestra <span class="text-lluvia-primary">Visión</span>
      </h2>
      <div class="w-20 h-1 bg-lluvia-primary mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <div data-aos="fade-up" data-aos-delay="0">
        <Card className="h-full bg-white bg-opacity-10 border-2 border-lluvia-primary border-opacity-30 backdrop-blur-sm text-white hover:bg-opacity-15 transition-all duration-300">
          <div class="w-16 h-16 bg-lluvia-primary bg-opacity-25 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-8 h-8 text-lluvia-primary" fill="currentColor" viewBox="0 0 20 20">
              <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.343a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM15.657 14.657a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM11 17v-1a1 1 0 112 0v1a1 1 0 11-2 0zM4.343 15.657a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM2 10a1 1 0 011-1h1a1 1 0 110 2H3a1 1 0 01-1-1zM4.343 4.343a1 1 0 000-1.414L3.636 2.22a1 1 0 00-1.414 1.414l.707.707zM10 5a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-center mb-3 text-white">Innovación</h3>
          <p class="text-center text-gray-300">
            Ser líderes en desarrollo de productos innovadores y sostenibles.
          </p>
        </Card>
      </div>

      <div data-aos="fade-up" data-aos-delay="100">
        <Card className="h-full bg-white bg-opacity-10 border-2 border-lluvia-primary border-opacity-30 backdrop-blur-sm text-white hover:bg-opacity-15 transition-all duration-300">
          <div class="w-16 h-16 bg-lluvia-primary bg-opacity-25 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-8 h-8 text-lluvia-primary" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.5.735v8.485a.75.75 0 001.262.574l6.846-5.887 6.846 5.887a.75.75 0 001.262-.574V6.235a.75.75 0 00-.5-.735A60.376 60.376 0 0010 5.5c-2.045 0-4.088.085-6.11.25zm0 2a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5a.75.75 0 01.75-.75z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-center mb-3 text-white">Confiabilidad</h3>
          <p class="text-center text-gray-300">
            Productos confiables que brindan resultados excepcionales garantizados.
          </p>
        </Card>
      </div>

      <div data-aos="fade-up" data-aos-delay="200">
        <Card className="h-full bg-white bg-opacity-10 border-2 border-lluvia-primary border-opacity-30 backdrop-blur-sm text-white hover:bg-opacity-15 transition-all duration-300">
          <div class="w-16 h-16 bg-lluvia-primary bg-opacity-25 rounded-lg flex items-center justify-center mb-4 mx-auto">
            <svg class="w-8 h-8 text-lluvia-primary" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-center mb-3 text-white">Sostenibilidad</h3>
          <p class="text-center text-gray-300">
            Cuidar el planeta mientras cuidamos de ti y tu familia.
          </p>
        </Card>
      </div>
    </div>

    <div data-aos="fade-up" class="bg-white bg-opacity-10 backdrop-blur-sm rounded-xl p-8 border-2 border-lluvia-primary border-opacity-30 text-center text-white">
      <p class="text-lg">
        <span class="font-bold text-lluvia-primary">Nuestra visión</span> es convertir a Lluvia en la marca preferida de limpieza, reconocida por la calidad de nuestros productos, nuestro compromiso con la sostenibilidad y nuestra dedicación a la satisfacción del cliente.
      </p>
    </div>
  </Container>
</section>
