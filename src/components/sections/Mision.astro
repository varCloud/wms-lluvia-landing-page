---
import Container from '../base/Container.astro';
import Card from '../base/Card.astro';
---

<section class="py-20 bg-white" id="mision">
  <Container>
    <div data-aos="fade-up" class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-lluvia-secondary mb-4">
        Nuestra <span class="text-lluvia-primary">Misión</span>
      </h2>
      <div class="w-20 h-1 bg-lluvia-primary mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div data-aos="fade-right">
        <Card className="border-l-4 border-lluvia-primary">
          <p class="text-gray-700 text-lg leading-relaxed">
            En Lluvia, nuestra misión es proporcionar productos de limpieza de la más alta calidad que ayuden a nuestros clientes a mantener sus hogares impecables y saludables. Nos comprometemos a ofrecer soluciones efectivas y sostenibles, respaldadas por innovación y excelencia en el servicio.
          </p>
        </Card>
      </div>

      <div data-aos="fade-left" class="space-y-4">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-lluvia-primary rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-lluvia-secondary" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lluvia-secondary mb-2">Calidad Garantizada</h3>
            <p class="text-gray-600">Todos nuestros productos cumplen con los más altos estándares de calidad.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-lluvia-primary rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-lluvia-secondary" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lluvia-secondary mb-2">Innovación Continua</h3>
            <p class="text-gray-600">Estamos siempre buscando mejorar nuestras fórmulas y presentaciones.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-lluvia-primary rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-lluvia-secondary" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lluvia-secondary mb-2">Sostenibilidad</h3>
            <p class="text-gray-600">Comprometidos con el medio ambiente en todas nuestras operaciones.</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
