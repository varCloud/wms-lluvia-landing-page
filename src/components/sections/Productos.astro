---
import Container from '../base/Container.astro';
import Card from '../base/Card.astro';
import Button from '../base/Button.astro';
import { productLines } from '../../data/productosData';
---

<section class="py-20 bg-gray-50" id="productos">
  <Container>
    <div data-aos="fade-up" class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-lluvia-secondary mb-4">
        Nuestras <span class="text-lluvia-primary">Líneas de Productos</span>
      </h2>
      <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
        Ofrecemos una amplia variedad de productos organizados en diferentes líneas especializadas para cada necesidad de limpieza e higiene.
      </p>
      <div class="w-20 h-1 bg-lluvia-primary mx-auto"></div>
    </div>

    <!-- Grid de Líneas de Productos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {Object.entries(productLines).map(([lineName, lineData], index) => (
        <div 
          data-aos="fade-up" 
          data-aos-delay={index * 100}
          class="group cursor-pointer"
        >
          <Card className="h-full bg-white hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
            <div class="flex items-start justify-between mb-4">
              <div class={`${lineData.color} text-white text-4xl w-16 h-16 rounded-lg flex items-center justify-center`}>
                {lineData.icon}
              </div>
              <div class="text-lluvia-primary text-2xl opacity-0 group-hover:opacity-100 transition-opacity">→</div>
            </div>
            
            <h3 class="text-2xl font-bold text-lluvia-secondary mb-2">
              {lineName.replace('Linea ', '').replace('Línea ', '')}
            </h3>
            
            <p class="text-gray-600 text-sm mb-4 h-10">
              {lineData.description}
            </p>

            <!-- Productos Preview -->
            <div class="space-y-2 mb-4 max-h-32 overflow-hidden">
              {lineData.items.slice(0, 5).map((item) => (
                <div class="flex items-center text-sm text-gray-700 group-hover:text-lluvia-primary transition-colors">
                  <span class="text-lluvia-primary mr-2">•</span>
                  <span class="truncate">{item}</span>
                </div>
              ))}
              {lineData.items.length > 5 && (
                <div class="text-sm text-lluvia-primary font-semibold pt-2">
                  +{lineData.items.length - 5} productos más
                </div>
              )}
            </div>

            <!-- Badge de cantidad -->
            <div class="absolute top-4 right-4 bg-lluvia-primary text-white text-xs font-bold px-3 py-1 rounded-full">
              {lineData.items.length} items
            </div>
          </Card>
        </div>
      ))}
    </div>

    <!-- Sección de Llamada a Acción -->
    <div class="mt-16 p-12 bg-gradient-to-r from-lluvia-secondary to-lluvia-secondary/80 rounded-lg text-center text-white">
      <h3 class="text-3xl font-bold mb-4">Explora Todo Nuestro Catálogo</h3>
      <p class="text-lg mb-8 opacity-90">
        Accede a nuestro catálogo completo con más de 100 productos. Busca, filtra y encuentra exactamente lo que necesitas.
      </p>
      <Button variant="outline" href="/productos" className="text-lg px-8 py-4 bg-white text-lluvia-secondary hover:bg-lluvia-primary hover:text-white">
        Ver Todos los Productos
      </Button>
    </div>

    <div class="text-center mt-12">
      <Button variant="primary" href="#contacto" className="text-lg px-8 py-4">
        Ordenar Ahora
      </Button>
    </div>
  </Container>
</section>
