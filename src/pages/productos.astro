---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BuscadorProductos from '../components/BuscadorProductos.astro';
---

<Layout>
  <Header />
  
  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-lluvia-primary to-lluvia-secondary text-white py-16">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-4">
          Catálogo Completo de Productos
        </h1>
        <p class="text-xl md:text-2xl text-gray-100 mb-8">
          Explora todas nuestras líneas de productos. Más de 100 artículos para tus necesidades de limpieza e higiene.
        </p>
        <div class="w-20 h-1 bg-white mx-auto"></div>
      </div>
    </section>

    <!-- Sección de Búsqueda y Productos -->
    <section class="py-16 bg-gray-50">
      <BuscadorProductos />
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  :global(body) {
    scroll-behavior: smooth;
  }
</style>
